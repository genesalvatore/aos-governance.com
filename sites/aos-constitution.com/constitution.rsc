18:["$","section",null,{"className":"bg-white rounded-2xl p-8 shadow-sm border border-gray-100 mb-8","children":[["$","h3",null,{"className":"text-2xl font-bold text-gray-900 mb-4","children":"THE PROMISE ETCHED IN STONE"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":["This is not marketing language.",["$","br",null,{}],"This is not a mission statement that will be forgotten when profit calls.",["$","br",null,{}],"This is not a value proposition to be abandoned when regulation demands."]}],["$","p",null,{"className":"text-gray-900 leading-relaxed font-bold","children":"This is a covenant. An unbreakable promise. A founding principle of AOS that cannot be compromised."}]]}]
