1c:["$","p",null,{"className":"text-gray-700 leading-relaxed mb-6","children":"Amodei describes Anthropic's goal as training Claude to “almost never go against the spirit of its constitution.” This is valuable—teaching good judgment for novel situations."}]
1d:["$","p",null,{"className":"text-gray-700 leading-relaxed mb-6","children":["But “almost never” isn't enough for high-stakes deployments. When AI systems control critical infrastructure, process sensitive data, or make consequential decisions, we need more than probabilistic alignment. We need ",["$","strong",null,{"children":"provable compliance"}],"."]}]
1e:["$","p",null,{"className":"text-gray-700 leading-relaxed mb-6","children":["That's where cryptographic governance comes in. Not as a replacement for alignment training, but as a ",["$","strong",null,{"children":"complementary accountability layer"}],"."]}]
