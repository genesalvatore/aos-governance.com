22:["$","p",null,{"className":"text-gray-700 leading-relaxed mb-6","children":"The AOS Constitutional Framework was first committed to GitHub on January 1, 2026. Patents on core governance methods were filed on January 10 and 27, 2026. We launched publicly on January 23, 2026."}]
